{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$(git rev-parse --show-toplevel)/scripts/agent-lint-hook.sh\" turn-start"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "apply_patch",
				"hooks": [
					{
						"type": "command",
						"command": "\"$(git rev-parse --show-toplevel)/scripts/agent-lint-hook.sh\" after-tool"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$(git rev-parse --show-toplevel)/scripts/agent-lint-hook.sh\" check",
						"timeout": 120,
						"statusMessage": "Linting files changed by the agent"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$(git rev-parse --show-toplevel)/scripts/agent-lint-hook.sh\" check",
						"timeout": 120,
						"statusMessage": "Linting files changed by the agent"
					}
				]
			}
		]
	}
}
