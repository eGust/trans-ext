{
	"manifest_version": 3,
	"minimum_chrome_version": "138",
	"name": "AI Translate",
	"version": "0.2.0",
	"description": "Translate on your device or with Google Gemini using your own key. Automatic language direction and local speech.",
	"permissions": ["contextMenus", "storage", "tts", "activeTab", "scripting"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "AI Translate",
		"default_icon": {
			"16": "icons/16.png",
			"32": "icons/32.png"
		}
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"commands": {
		"translate-selection": {
			"description": "Translate selected text in a new tab"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://generativelanguage.googleapis.com; base-uri 'none'; frame-ancestors 'none'"
	}
}
